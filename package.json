{
  "name": "coordinate-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @coordinate-toolkit/web dev",
    "build": "tsc -b && pnpm --filter @coordinate-toolkit/web build",
    "preview": "pnpm --filter @coordinate-toolkit/web preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "pnpm --filter @coordinate-toolkit/converter test:slow"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@12.x"
}
